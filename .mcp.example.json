{
  "mcpServers": {
    "upgates": {
      "command": "python",
      "args": ["-m", "connector"],
      "cwd": "/absolute/path/to/upgates-com-mcp",
      "env": {
        "OPENMCP_MODE": "local-stdio",
        "UPGATES_API_URL": "https://vas-eshop.admin.upgates.com/api/v2",
        "UPGATES_API_LOGIN": "api-login",
        "UPGATES_API_KEY": "api-kluc",
        "UPGATES_READ_ONLY": "true",
        "UPGATES_ANONYMIZE_DATA": "true",
        "OPENMCP_PII_SALT": "vygeneruj-vlastni-openssl-rand-hex-32"
      }
    }
  }
}
